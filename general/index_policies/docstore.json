{"docstore/metadata": {"f813ec11-dfb4-4234-a785-5fb92f942785": {"doc_hash": "d4f30590dc4a69d212def53e507de3940f72b05f695215fda74f8b5ec494e260"}, "29501965-4a4a-4783-aad4-330f57683a71": {"doc_hash": "5b4e83fdcbbca7b536d127e87201d87e958a16de40aae65f3a41959d7bcbba08"}, "9e5e4c85-9989-443f-a246-7cf3d38b2bc9": {"doc_hash": "942b5d02027e100ed9c7a95d0fd84c2a79d048e89315f22128e40272667ceb73"}, "94d6c333-9c37-4ed1-928a-c9d9f8551e53": {"doc_hash": "41a34f051cb1e3d6002dab5c1eff1633491f54f0aead82e431963c51103e7229"}, "edfa742e-d4ab-42fe-9492-25289ecf7813": {"doc_hash": "5f4b9f77545aa91bc11f9833cd4640b08089e9449ddbf23eea823748c3dfee2e", "ref_doc_id": "f813ec11-dfb4-4234-a785-5fb92f942785"}, "4c8a1411-0b20-48c5-8c4c-85a8af5368a0": {"doc_hash": "3482b58e4a3cded0f525e4748400b90386c9f5d99584a3ae7966d967d2d5d543", "ref_doc_id": "29501965-4a4a-4783-aad4-330f57683a71"}, "3031dec7-49a7-453c-bcb9-9177490cf3c2": {"doc_hash": "237cb7b3584c0e31ddf05d967d1a09203394d7bddf3f579ddd3dda9417bf7ac3", "ref_doc_id": "9e5e4c85-9989-443f-a246-7cf3d38b2bc9"}, "6372c85e-c699-43b2-b93e-f43b61a18f85": {"doc_hash": "7cb8da426c8ca2e5cae0835e4879d497e422e1236f1c9fa0f9419b3d3277dd00", "ref_doc_id": "94d6c333-9c37-4ed1-928a-c9d9f8551e53"}}, "docstore/data": {"edfa742e-d4ab-42fe-9492-25289ecf7813": {"__data__": {"id_": "edfa742e-d4ab-42fe-9492-25289ecf7813", "embedding": null, "metadata": {}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "f813ec11-dfb4-4234-a785-5fb92f942785", "node_type": "4", "metadata": {}, "hash": "d4f30590dc4a69d212def53e507de3940f72b05f695215fda74f8b5ec494e260", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "Policy Type: Generalpolicies\nUOB General Rules and Policies\n\n1- The student must show respect and ethical behavior.\n2- Students must follow the specified dress code.\n3- Students must not damage any university property.\n4- Mobile phones must be turned off or kept silent during lectures and exams.\n5- Attendance is mandatory for all lectures, labs, and tutorials unless stated otherwise.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 386, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "4c8a1411-0b20-48c5-8c4c-85a8af5368a0": {"__data__": {"id_": "4c8a1411-0b20-48c5-8c4c-85a8af5368a0", "embedding": null, "metadata": {}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "29501965-4a4a-4783-aad4-330f57683a71", "node_type": "4", "metadata": {}, "hash": "5b4e83fdcbbca7b536d127e87201d87e958a16de40aae65f3a41959d7bcbba08", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "Policy Type: Generalpolicies\n6- Academic honesty is expected in all coursework, and plagiarism is strictly prohibited.\n7- Students are required to carry their university ID cards at all times on campus.\n8- Eating and drinking are not permitted in computer labs and lecture halls.\n9- All students must adhere to safety protocols in laboratories and workshops.\n10- Smoking and vaping are prohibited in all indoor university facilities.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 433, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "3031dec7-49a7-453c-bcb9-9177490cf3c2": {"__data__": {"id_": "3031dec7-49a7-453c-bcb9-9177490cf3c2", "embedding": null, "metadata": {}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "9e5e4c85-9989-443f-a246-7cf3d38b2bc9", "node_type": "4", "metadata": {}, "hash": "942b5d02027e100ed9c7a95d0fd84c2a79d048e89315f22128e40272667ceb73", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "Policy Type: Studiespolicies\nUOB Studies Related Rules and Policies\n\n1- The student must not register more than 19 credits and not less than 12 credits per semester, registering 12 credits will be allowed only once.\n2- The student must not exceed the number of academic years specified in the study plan.\n3- The student must not receive an 'F' grade in the same course more than three times.\n4- The student must not exceed 25% absence in any course during a semester.\n5- The student must maintain a minimum GPA of 2.00 to remain in good academic standing.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 555, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "6372c85e-c699-43b2-b93e-f43b61a18f85": {"__data__": {"id_": "6372c85e-c699-43b2-b93e-f43b61a18f85", "embedding": null, "metadata": {}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "94d6c333-9c37-4ed1-928a-c9d9f8551e53", "node_type": "4", "metadata": {}, "hash": "41a34f051cb1e3d6002dab5c1eff1633491f54f0aead82e431963c51103e7229", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "Policy Type: Studiespolicies\n6- Students on academic probation must meet with their academic advisor before registering.\n7- Withdrawal from a course is allowed only during the official withdrawal period.\n8- Courses with a grade of 'C' or lower may be repeated to improve GPA.\n9- Transfer students must complete at least 50% of their credit hours at UOB to graduate.\n10- Students must complete all prerequisite courses before enrolling in higher-level courses.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 459, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}}, "docstore/ref_doc_info": {"f813ec11-dfb4-4234-a785-5fb92f942785": {"node_ids": ["edfa742e-d4ab-42fe-9492-25289ecf7813"], "metadata": {}}, "29501965-4a4a-4783-aad4-330f57683a71": {"node_ids": ["4c8a1411-0b20-48c5-8c4c-85a8af5368a0"], "metadata": {}}, "9e5e4c85-9989-443f-a246-7cf3d38b2bc9": {"node_ids": ["3031dec7-49a7-453c-bcb9-9177490cf3c2"], "metadata": {}}, "94d6c333-9c37-4ed1-928a-c9d9f8551e53": {"node_ids": ["6372c85e-c699-43b2-b93e-f43b61a18f85"], "metadata": {}}}}