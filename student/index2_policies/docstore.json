{"docstore/metadata": {"266299c0-eae9-4b1a-adf1-66ff81028d95": {"doc_hash": "fb4e4eb43a3b2c2f7b13f37aaf81fb752125f3b07275a1e46fda2fbd11bc4afe"}, "f22026ab-5179-4a43-b301-a96532ffadb2": {"doc_hash": "481ba78d3ea7a045991f32df8e42539e18e39fa23aa004cab9c9ee3f0a4a14a9"}, "a2f59815-4e59-41b1-be50-f71a3eb83a43": {"doc_hash": "712be23e4b1f8ac408a5dd990e538e0dcaf2d9da36c5e03bc785fd3f248373a2"}, "72220067-6967-4869-a11c-b29b23396314": {"doc_hash": "e83327f7b942aaa4dd3b6640a7167c799dab6072d879592f33a9bc3e166cdb6a"}, "3f1ff7a1-2301-4ff9-8a11-89b953a9f769": {"doc_hash": "5975f7b4f1e3bb57a6d539d4ed9280813a8fa572cdb9223fce1cca39c7595e98", "ref_doc_id": "266299c0-eae9-4b1a-adf1-66ff81028d95"}, "a644c1b7-7102-42c8-bd07-72ba3dbdaf21": {"doc_hash": "4e8d51c99f958d5c556028c034873be4668be407d2f06bf8ca9af24fbe2f5409", "ref_doc_id": "f22026ab-5179-4a43-b301-a96532ffadb2"}, "b1dec730-832c-48be-a0eb-aa15dea4e90e": {"doc_hash": "1904528f4403bb8f57c68d324456132e4a606dda0cd8c0a1f3bc043c30b6eaf6", "ref_doc_id": "a2f59815-4e59-41b1-be50-f71a3eb83a43"}, "a16f96a4-b638-462f-a36d-de0f9d3c4494": {"doc_hash": "441c0c615dd59f96058d817d3d49109e38378eb65bac87b2ed71308aee131fff", "ref_doc_id": "72220067-6967-4869-a11c-b29b23396314"}}, "docstore/data": {"3f1ff7a1-2301-4ff9-8a11-89b953a9f769": {"__data__": {"id_": "3f1ff7a1-2301-4ff9-8a11-89b953a9f769", "embedding": null, "metadata": {"policy_type": "Generalpolicies"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "266299c0-eae9-4b1a-adf1-66ff81028d95", "node_type": "4", "metadata": {"policy_type": "Generalpolicies"}, "hash": "fb4e4eb43a3b2c2f7b13f37aaf81fb752125f3b07275a1e46fda2fbd11bc4afe", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "Policy Type: Generalpolicies\nUOB General Rules and Policies\n\n1- The student must show respect and ethical behavior.\n2- Students must follow the specified dress code.\n3- Students must not damage any university property.\n4- Mobile phones must be turned off or kept silent during lectures and exams.\n5- Attendance is mandatory for all lectures, labs, and tutorials unless stated otherwise.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 386, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "a644c1b7-7102-42c8-bd07-72ba3dbdaf21": {"__data__": {"id_": "a644c1b7-7102-42c8-bd07-72ba3dbdaf21", "embedding": null, "metadata": {"policy_type": "Generalpolicies"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "f22026ab-5179-4a43-b301-a96532ffadb2", "node_type": "4", "metadata": {"policy_type": "Generalpolicies"}, "hash": "481ba78d3ea7a045991f32df8e42539e18e39fa23aa004cab9c9ee3f0a4a14a9", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "Policy Type: Generalpolicies\n6- Academic honesty is expected in all coursework, and plagiarism is strictly prohibited.\n7- Students are required to carry their university ID cards at all times on campus.\n8- Eating and drinking are not permitted in computer labs and lecture halls.\n9- All students must adhere to safety protocols in laboratories and workshops.\n10- Smoking and vaping are prohibited in all indoor university facilities.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 433, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "b1dec730-832c-48be-a0eb-aa15dea4e90e": {"__data__": {"id_": "b1dec730-832c-48be-a0eb-aa15dea4e90e", "embedding": null, "metadata": {"policy_type": "Studiespolicies"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "a2f59815-4e59-41b1-be50-f71a3eb83a43", "node_type": "4", "metadata": {"policy_type": "Studiespolicies"}, "hash": "712be23e4b1f8ac408a5dd990e538e0dcaf2d9da36c5e03bc785fd3f248373a2", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "Policy Type: Studiespolicies\nUOB Studies Related Rules and Policies\n\n1- The student must not register more than 19 credits and not less than 12 credits per semester, registering 12 credits will be allowed only once.\n2- The student must not exceed the number of academic years specified in the study plan.\n3- The student must not receive an 'F' grade in the same course more than three times.\n4- The student must not exceed 25% absence in any course during a semester.\n5- The student must maintain a minimum GPA of 2.00 to remain in good academic standing.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 555, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, "a16f96a4-b638-462f-a36d-de0f9d3c4494": {"__data__": {"id_": "a16f96a4-b638-462f-a36d-de0f9d3c4494", "embedding": null, "metadata": {"policy_type": "Studiespolicies"}, "excluded_embed_metadata_keys": [], "excluded_llm_metadata_keys": [], "relationships": {"1": {"node_id": "72220067-6967-4869-a11c-b29b23396314", "node_type": "4", "metadata": {"policy_type": "Studiespolicies"}, "hash": "e83327f7b942aaa4dd3b6640a7167c799dab6072d879592f33a9bc3e166cdb6a", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "Policy Type: Studiespolicies\n6- Students on academic probation must meet with their academic advisor before registering.\n7- Withdrawal from a course is allowed only during the official withdrawal period.\n8- Courses with a grade of 'C' or lower may be repeated to improve GPA.\n9- Transfer students must complete at least 50% of their credit hours at UOB to graduate.\n10- Students must complete all prerequisite courses before enrolling in higher-level courses.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 459, "metadata_seperator": "\n", "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}}, "docstore/ref_doc_info": {"266299c0-eae9-4b1a-adf1-66ff81028d95": {"node_ids": ["3f1ff7a1-2301-4ff9-8a11-89b953a9f769"], "metadata": {"policy_type": "Generalpolicies"}}, "f22026ab-5179-4a43-b301-a96532ffadb2": {"node_ids": ["a644c1b7-7102-42c8-bd07-72ba3dbdaf21"], "metadata": {"policy_type": "Generalpolicies"}}, "a2f59815-4e59-41b1-be50-f71a3eb83a43": {"node_ids": ["b1dec730-832c-48be-a0eb-aa15dea4e90e"], "metadata": {"policy_type": "Studiespolicies"}}, "72220067-6967-4869-a11c-b29b23396314": {"node_ids": ["a16f96a4-b638-462f-a36d-de0f9d3c4494"], "metadata": {"policy_type": "Studiespolicies"}}}}